  <link name="left_ankle_pitch_link"/>
  <joint name="left_ankle_pitch_joint" type="revolute"><parent link="left_knee_link"/><child link="left_ankle_pitch_link"/></joint>
  <link name="left_ankle_roll_link"/>
  <joint name="left_ankle_roll_joint" type="revolute"><parent link="left_ankle_pitch_link"/><child link="left_ankle_roll_link"/></joint>
  <link name="right_hip_pitch_link"/>
  <joint name="right_hip_pitch_joint" type="revolute"><parent link="pelvis"/><child link="right_hip_pitch_link"/></joint>
  <link name="right_hip_roll_link"/>
